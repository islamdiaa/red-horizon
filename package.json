{
  "name": "red-horizon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "simtest": "node --import tsx tools/simtest.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "icons": "node tests/tools/make-icons.mjs",
    "verify:pwa": "node tests/tools/verify-pwa.mjs",
    "audit:leaks": "node tests/perf/leaks.mjs",
    "audit:profile": "node tests/perf/profile.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "GPL-3.0-or-later"
}
