{
  "name": "red-horizon",
  "private": true,
  "version": "0.1.0",
  "description": "The gameplay of Command & Conquer: Red Alert, rebuilt for the browser in real-time 3D (TypeScript, three.js, no copyrighted assets).",
  "keywords": [
    "rts",
    "real-time-strategy",
    "red-alert",
    "game",
    "threejs",
    "webgl",
    "typescript",
    "browser-game"
  ],
  "homepage": "https://github.com/islamdiaa/red-horizon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islamdiaa/red-horizon.git"
  },
  "bugs": {
    "url": "https://github.com/islamdiaa/red-horizon/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:itch": "tsc --noEmit && node tools/release/build-itch.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "simtest": "node --import tsx tools/simtest.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "icons": "node tests/tools/make-icons.mjs",
    "verify:pwa": "node tests/tools/verify-pwa.mjs",
    "audit:leaks": "node tests/perf/leaks.mjs",
    "audit:profile": "node tests/perf/profile.mjs",
    "desktop": "npm --prefix desktop install --no-audit --no-fund && npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop install --no-audit --no-fund && npm --prefix desktop run build"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
