# Copy to tools/lab/.env (git-ignored) and adjust. lab.sh reads it.

# Secrets directory (mode 700): lab_ed25519(.pub), win11-admin.pass, ubuntu-user.pass.
# lab.sh also writes the generated answer/seed media and SSH known_hosts here.
LAB_SECRETS=/path/to/rh-lab/secrets

# Parent directory for the VM disks; each VM gets <LAB_DISKS>/<vm name>/.
LAB_DISKS=/path/to/domains

# Install media.
LAB_UBUNTU_IMG=/path/to/noble-server-cloudimg-amd64.img
LAB_WIN_ISO=/path/to/rh-test-win11-eval.iso
LAB_VIRTIO_ISO=/path/to/virtio-win.iso

# Where `lab.sh run` copies results back to (default: ~/.cache/rh-lab-out).
#LAB_OUT=/path/to/lab-out

# The game as seen from inside the VMs (libvirt NAT gateway).
# Default: http://<the NAT network gateway>:8091/
#LAB_GAME_URL=http://<gateway>:5303/
