#cloud-config
# Rendered by tools/lab/lab.sh build ubuntu (the hash and key come from the lab secrets).
hostname: rh-test-ubuntu
timezone: UTC
users:
  - name: @USER@
    gecos: Red Horizon lab
    groups: [adm, sudo, video, render]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    passwd: "@HASH@"
    ssh_authorized_keys:
      - "@PUBKEY@"
ssh_pwauth: false
disable_root: true
growpart:
  mode: auto
  devices: ["/"]
package_update: true
packages:
  - qemu-guest-agent
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
